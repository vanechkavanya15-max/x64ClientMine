      "luria": {
        "display_name": "Luria Online (UPM Profil Luria)",
        "description": "Protokol produkcyjny serwera Luria z 1-bajtowym ramkowaniem, tablica 137 pakietow GC, DH2 MODP 1024-bit i Blowfish CTR.",
        "framing": {
          "type": "TABLE_LOOKUP_1B",
          "header_size_bytes": 1,
          "format": "[Header: 1B (uint8_t)][Payload...]",
          "dynamic_handling": "16-bit uint16_t little-endian na offsetcie 1 (CHAT 0x04, WHISPER 0x05, SCRIPT 0x26), lub 32-bit uint32_t na offsetcie 1 dla pakietu 0xBE"
        },
        "cryptography": {
          "key_agreement": "Diffie-Hellman DH2 MODP 1024-bit (256B handshake, selekcja c1==11 && c2==11)",
