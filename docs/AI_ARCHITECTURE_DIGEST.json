  "domains": {
    "Actors": {
      "path": "src/Client/Actors",
      "responsibility": "Komponenty instancji aktorow, integracja ruchu w pikselach, synchronizacja pozycji i animacji."
    },
    "Bridge": {
      "path": "src/Client/Bridge",
      "responsibility": "Natywne mostki C-ABI (BotApi_FFI), PhaseGame*Bridge, translatory zdarzen i telemetryczne dla Pythona i MCP."
    },
    "Contracts": {
      "path": "src/Client/Contracts",
      "responsibility": "Czyste kontrakty domenowe C++23 (IPlayer, IWorld, ICombat, IInventory) oraz struktury POD DTOs."
    },
    "Core": {
      "path": "src/Client/Core",
      "responsibility": "Fundamenty silnika, logowanie TraceError, zarzadzanie czasem i konfiguracja klienta."
    },
    "Events": {
      "path": "src/Client/Events",
      "responsibility": "Szyna zdarzen domenowych, delegaty pub/sub, powiadomienia o zmianie stanu."
    },
    "Gameplay": {
      "path": "src/Client/Gameplay",
      "responsibility": "Logika rozgrywki: kontrolery ruchu, rate limiting, nawigacja pathfinding i walidacja kolizji terenu."
    },
    "Graphics": {
      "path": "src/Client/Graphics",
      "responsibility": "Silnik renderowania, viewport kamery, zarzadzanie buforami render target i efektami wizualnymi."
    },
    "Headless": {
      "path": "src/Client/Headless",
      "responsibility": "Tryb bezglowy (0% GPU) bez okna Win32 i Direct3D, deterministyczny dlawik 60 Hz z pelna fizyka terenu."
    },
    "Input": {
      "path": "src/Client/Input",
      "responsibility": "Przechwytywanie wejscia klawiatury i myszy, mapowanie komend ruchu i ataku."
    },
    "IPC": {
      "path": "src/Client/IPC",
      "responsibility": "Komunikacja miedzyprocesowa JSON-RPC 2.0 przez potok nazwany \\\\.\\pipe\\M2ClientEngineHarness."
    },
    "MCP": {
      "path": "src/Client/MCP",
      "responsibility": "Mostek Model Context Protocol (AgentMCPBridge) laczacy agentow AI z wewnetrznymi kontraktami domenowymi."
    },
    "Mimic": {
      "path": "src/Client/Mimic",
      "responsibility": "Symulacja zachowania gracza: rozklad opoznien Gaussa (GaussianPacketJitter), humanizacja akcji."
    },
    "MiniMap": {
      "path": "src/Client/MiniMap",
      "responsibility": "Zarzadzanie punktami nawigacyjnymi (waypoints), radar encji i wizualizacja mapy.",
      "components": [
        "MiniMapWaypointTracker (zarzadzanie waypointami, markerami misji i interpolacja obserwatorow)",
        "MiniMapCoordinateProjector (czysta matematyka rzutowania 3D swiata na radar 2D i Atlas)"
      ]
    },
    "Network": {
      "path": "src/Client/Network",
      "responsibility": "Protokol sieciowy: dynamiczny framer pakietow, kodeki pakietow, dyspozytor oraz mechanizm recovery po desynchronizacji."
    },
    "Player": {
      "path": "src/Client/Player",
      "responsibility": "Zarzadzanie stanem gracza: wspolrzedne, punkty HP/SP, poziom, doswiadczenie, waluta Yang, buffy."
    },
    "Skills": {
      "path": "src/Client/Skills",
      "responsibility": "Drzewka umiejetnosci, obsluga czasu odnowienia (cooldown), sprawdzanie wymagan i aktywacja skilli."
    },
    "Terrain": {
      "path": "src/Client/Terrain",
      "responsibility": "Ladowanie terenu swiata, kalkulacja wysokosci CPythonBackground::GetHeight, sprawdzanie kolizji scian."
    },
    "UI": {
      "path": "src/Client/UI",
      "responsibility": "Nowoczesne kontrolery interfejsu uzytkownika, niezalezne od srodowiska Pythona.",
      "components": [
        "PythonNetworkStreamModule_TradeShop (dekompozycja handlu, sklepow i magazynu)",
        "PythonNetworkStreamModule_GuildParty (dekompozycja gildii, grupy i znajomych)",
        "PythonCharacterModule_Visual (zarzadzanie instancjami, zbrojami, broniami, fryzurami, szarfami i efektami)",
        "PythonCharacterModule_Motion (ruch, rotacja, combo, tryby walki i animacje)"
      ]
    },
    "World": {
      "path": "src/Client/World",
      "responsibility": "Zarzadzanie encjami swiata, siatka przestrzenna SpatialHashGrid, zapytania w promieniu."
    }
  },
