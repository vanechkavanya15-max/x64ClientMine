# ========================================================
# GitIgnore dla Klienta Metin2 (Visual Studio 2022 / C++)
# ========================================================

# Katalogi wyjsciowe kompilacji i architektury
[Dd]ebug/
[Rr]elease/
[Dd]istribute/
x64/
x86/
[Bb]in/
[Oo]bj/
ipch/

# Pliki i katalogi wewnetrzne Visual Studio
.vs/
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.suo
*.user
*.userosv
*.sln.docstates

# Pliki obiektowe, prekompilowane naglowki i symbole
*.obj
*.pch
*.pdb
*.idb
*.ilk
*.exp
*.cod
*.iobj
*.ipdb
*.map
*.res
*.tlog
*.lastbuildstate
*.recipe
*.log

# Pliki wykonywalne i biblioteki ladowane dynamicznie z kompilacji
binary/*.exe
!binary/.gitkeep

# Plik przekraczajacy limit GitHuba (>100MB)
Cryptopp_lib_debug.lib

# Kopie zapasowe i pliki tymczasowe edytorow
*.orig
*.rej
*.bak
*~
*.tmp

# Rust & Python build cache
target/
.pytest_cache/
__pycache__/
*.pyc

