# =============================================================================
# .gitignore - SourceCodeClient (Metin2 x64 C++23)
# Zoptymalizowany dla czystego repozytorium kodu zrodlowego (src, tests, extern)
# =============================================================================

# ─── 1. ZAGNIEZDZONE KLONY I KOPIE BACKUPU ──────────────────────────────────
m2dev client backlup/
m2dev-client-backlup/
*backup*/
*backlup*/

# ─── 2. DUZE FOLDERY RUNTIME, ASSETY I ZRZUTY GRY (4.5+ GB) ──────────────────
# Caly runtime klienta gry, nieskompresowane asety i archiwa gry
m2dev-client-main/
assets/
pack/
bgm/
upload/
mark/
servers/
dump/
DUMP/
*dump/
*DUMP/
/client/
output/

# ─── 3. ARTEFAKTY BUDOWANIA CMAKE, MSVC I NINJA (6.0+ GB) ────────────────────
build/
buildtool/bin/
bin/
out/
x64/
x86/
Debug/
Release/
RelWithDebInfo/
MinSizeRel/
Testing/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
Makefile
build.ninja
.ninja_deps
.ninja_log

